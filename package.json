{
  "name": "astro-monitor",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build:libs": "pnpm --filter @astro/engine build",
    "dev": "pnpm -r --parallel dev",
    "smoke": "node scripts/smoke.mjs",
    "i18n:report": "tsx scripts/i18n-report.ts"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "description": "Astronaut Health Monitor: a Mission Control style health dashboard for a four-person crew (NASA Space Apps Challenge, Tashkent 2026). Developed with AI assistance, see README."
}
